/* ============================
   全局样式 - 快递查询小程序
   主色: #4F7CFF  成功: #07C160  危险: #FA5151
   ============================ */

page {
  --primary: #4F7CFF;
  --primary-light: #EDF2FF;
  --success: #07C160;
  --danger: #FA5151;
  --text: #333;
  --text-secondary: #999;
  --bg: #F6F7FB;
  --card-bg: #fff;
  --border: #EBEDF0;
  --radius: 16rpx;
  --shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);

  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.6;
}

/* 卡片 */
.card {
  background: var(--card-bg);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 32rpx;
  margin: 24rpx 0;
}

/* 主按钮 */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  text-align: center;
  width: 100%;
  line-height: 1.5;
  box-sizing: border-box;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.btn-primary::after {
  border: none;
}

/* 危险按钮 */
.btn-danger {
  background: var(--danger);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 26rpx;
  padding: 14rpx 32rpx;
  line-height: 1.5;
}

.btn-danger::after {
  border: none;
}

/* 搜索框 */
.search-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 0;
}

.search-input {
  flex: 1;
  background: var(--card-bg);
  border-radius: 40rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  box-shadow: var(--shadow);
  height: 80rpx;
  box-sizing: border-box;
}

.btn-search {
  flex-shrink: 0;
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  box-sizing: border-box;
}

.btn-search::after {
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--text-secondary);
}

.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-state .empty-text {
  font-size: 28rpx;
}

/* 骨架屏 */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
  border-radius: 8rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.skeleton-card {
  height: 180rpx;
  margin: 24rpx 0;
  border-radius: var(--radius);
}

/* 协议链接 */
.agreement-link {
  color: var(--primary);
  text-decoration: underline;
}

/* 协议内容区 */
.agreement-scroll {
  height: 400rpx;
  background: #fafafa;
  border-radius: var(--radius);
  padding: 24rpx;
  margin: 16rpx 0;
  font-size: 24rpx;
  line-height: 2;
}

.agreement-scroll .yhxy {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}
