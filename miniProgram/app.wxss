/* ═══ 全局变量 ═══ */
page {
  --primary: #4F7CFF;
  --primary-light: #EEF2FF;
  --success: #07C160;
  --danger: #FA5151;
  --warning: #FFC300;
  --bg: #F5F6FA;
  --card: #FFFFFF;
  --text: #1A1A2E;
  --text-sub: #666666;
  --text-muted: #999999;
  --border: #EEEEEE;
  --shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  --radius: 16rpx;
  --radius-sm: 8rpx;

  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background: var(--bg);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* ═══ 通用工具类 ═══ */

/* 弹性布局 */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }

/* 间距 */
.gap-sm { gap: 8rpx; }
.gap-md { gap: 16rpx; }
.gap-lg { gap: 24rpx; }

.p-sm { padding: 8rpx 16rpx; }
.p-md { padding: 16rpx 24rpx; }
.p-lg { padding: 24rpx 32rpx; }
.px-lg { padding-left: 32rpx; padding-right: 32rpx; }

.mt-sm { margin-top: 8rpx; }
.mt-md { margin-top: 16rpx; }
.mt-lg { margin-top: 24rpx; }
.mb-md { margin-bottom: 16rpx; }
.mb-lg { margin-bottom: 24rpx; }

/* 卡片 */
.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 24rpx;
  margin-bottom: 16rpx;
}

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  line-height: 1;
}

.btn::after { border: none; }

.btn-primary {
  background: var(--primary);
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-danger {
  background: var(--danger);
  color: #FFFFFF;
}

.btn-ghost {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.btn-sm {
  height: 64rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

/* 输入框 */
.input {
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--text);
}

.input-focus {
  border-color: var(--primary);
}

/* 文字 */
.text-primary { color: var(--primary); }
.text-sub { color: var(--text-sub); }
.text-muted { color: var(--text-muted); }
.text-danger { color: var(--danger); }
.text-success { color: var(--success); }
.text-bold { font-weight: 600; }

/* 骨架屏 */
.skeleton {
  background: linear-gradient(90deg, #F0F0F0 25%, #E8E8E8 50%, #F0F0F0 75%);
  background-size: 400% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: var(--radius);
}

@keyframes shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

/* 安全区 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
