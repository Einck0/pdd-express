/**
 * 首页样式
 */

.page-container {
  padding: 16rpx 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 32rpx);
}

/* ========== 轮播公告 ========== */
.banner-wrap {
  margin-bottom: 16rpx;
}

.banner-swiper {
  height: 64rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.banner-text {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0 24rpx;
  font-size: var(--font-caption);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ========== 搜索栏 ========== */
.search-bar {
  margin-bottom: 16rpx;
}

.search-input-wrap {
  height: 80rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: var(--font-body);
  padding-right: 16rpx;
}

.search-btn {
  width: 140rpx;
  flex-shrink: 0;
}

/* ========== 操作栏 ========== */
.action-bar {
  padding: 8rpx 8rpx 16rpx;
  margin-bottom: 8rpx;
}

.action-item {
  padding: 12rpx 0;
}

.action-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.action-text {
  font-size: var(--font-caption);
  color: var(--color-primary);
}

/* ========== 骨架屏 ========== */
.skeleton-list {
  margin-top: 8rpx;
}

.skeleton-card .skeleton-line,
.skeleton-card .skeleton-block {
  border-radius: 8rpx;
}

/* ========== 包裹卡片 ========== */
.package-list {
  margin-top: 8rpx;
}

.package-header {
  align-items: flex-start;
}

.package-waybill {
  display: flex;
  flex-direction: column;
}

.waybill-code {
  font-size: var(--font-body);
  font-weight: 500;
  margin-top: 4rpx;
  word-break: break-all;
}

.package-pickup {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.pickup-code {
  font-size: var(--font-pickup);
  font-weight: 700;
  line-height: 1;
  margin-top: 4rpx;
}

.package-info {
  flex-wrap: wrap;
  gap: 12rpx;
}

.info-tag {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  background: var(--color-bg);
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

/* ========== 重试按钮 ========== */
.empty-state .btn-ghost {
  width: 240rpx;
}
