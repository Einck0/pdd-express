/* 首页样式 */

.page {
  padding: var(--space-md);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── 公告 ── */
.notice {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-md) var(--space-lg);
  background: var(--color-brand-light);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-md);
}

.notice-icon { font-size: 28rpx; flex-shrink: 0; }

.notice-text {
  flex: 1;
  font-size: var(--text-sm);
  color: var(--color-brand-dark);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ── 搜索 ── */
.search-wrap {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.search-wrap .input-wrap { flex: 1; }

.search-btn { flex-shrink: 0; width: 140rpx; height: 96rpx; font-size: var(--text-base); }

/* ── 快捷操作 ── */
.shortcuts {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.shortcut {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  flex: 1;
  height: 80rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  box-shadow: var(--shadow-sm);
  transition: background .15s;
}

.shortcut:active { background: var(--color-bg-hover); }
.shortcut-icon { font-size: 28rpx; }

/* ── 骨架屏 ── */
.skeleton-card { padding: var(--space-lg) !important; }

/* ── 包裹卡片 ── */
.package-card {
  padding: var(--space-md) var(--space-lg) !important;
  transition: background .15s;
}

.package-card:active { background: var(--color-bg-hover); }

.package-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
}

.package-left {
  flex: 1;
  min-width: 0;
}

.package-waybill {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}

.package-info { font-size: var(--text-sm); }

.package-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.package-code {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-danger);
  font-family: "DIN Alternate", "Helvetica Neue", monospace;
  letter-spacing: 2rpx;
  line-height: 1;
}

/* ── Toast ── */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(.9);
  padding: var(--space-md) var(--space-xl);
  background: rgba(0, 0, 0, .7);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  opacity: 0;
  transition: opacity .2s, transform .2s;
  z-index: 100;
  pointer-events: none;
}

.toast-show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}
