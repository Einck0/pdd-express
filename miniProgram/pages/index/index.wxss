/* 首页样式 */
.page { padding: 24rpx; }

/* 公告 */
.banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: var(--primary-light);
  border-radius: var(--radius);
  margin-bottom: 24rpx;
}

.banner-icon { font-size: 28rpx; }

.banner-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 搜索 */
.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
}

.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 88rpx;
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 500;
}

.search-btn:active { opacity: 0.85; }

/* 操作栏 */
.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: var(--card);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow);
  flex: 1;
  justify-content: center;
}

.action-icon { font-size: 28rpx; }
.action-label { font-size: 24rpx; color: var(--text-sub); }

/* 骨架屏 */
.skeleton-card {
  padding: 24rpx;
  background: var(--card);
  border-radius: var(--radius);
  margin-bottom: 16rpx;
  box-shadow: var(--shadow);
}

.skeleton-line-long {
  height: 32rpx;
  width: 60%;
  margin-bottom: 16rpx;
}

.skeleton-line-short {
  height: 24rpx;
  width: 40%;
}

/* 包裹卡片 */
.package-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  margin-bottom: 16rpx;
}

.package-left { flex: 1; min-width: 0; }

.package-waybill {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.package-meta {
  font-size: 22rpx;
}

.package-code {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--danger);
  font-family: "DIN", "Helvetica Neue", monospace;
  margin-left: 16rpx;
  flex-shrink: 0;
}
