<!-- 首页：查件 -->
<view class="page">

  <!-- 轮播公告 -->
  <view class="banner" wx:if="{{banners.length}}">
    <view class="banner-icon">📢</view>
    <view class="banner-text">{{banners[bannerIdx]}}</view>
  </view>

  <!-- 搜索区 -->
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="输入单号或手机号查件"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      confirm-type="search"
      bindconfirm="onSearch"
    />
    <view class="search-btn" bindtap="onSearch">查件</view>
  </view>

  <!-- 操作栏 -->
  <view class="actions">
    <view class="action-item" bindtap="onRefresh">
      <text class="action-icon">🔄</text>
      <text class="action-label">刷新</text>
    </view>
    <view class="action-item" bindtap="onGoToBindPhone">
      <text class="action-icon">📱</text>
      <text class="action-label">管理手机号</text>
    </view>
  </view>

  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton skeleton-line-long"></view>
      <view class="skeleton skeleton-line-short"></view>
    </view>
  </block>

  <!-- 空状态：未绑定手机号 -->
  <view wx:elif="{{!hasPhones}}" class="empty">
    <view class="empty-icon">📱</view>
    <view class="empty-text">请先绑定手机号</view>
    <view class="btn btn-primary btn-sm mt-lg" bindtap="onGoToBindPhone">去绑定</view>
  </view>

  <!-- 空状态：无包裹 -->
  <view wx:elif="{{packages.length === 0}}" class="empty">
    <view class="empty-icon">📦</view>
    <view class="empty-text">暂无待取包裹</view>
  </view>

  <!-- 包裹列表 -->
  <view wx:else class="package-list">
    <view class="package-card" wx:for="{{packages}}" wx:key="waybill_code">
      <view class="package-left">
        <view class="package-waybill">{{item.waybill_code}}</view>
        <view class="package-meta text-muted">
          {{item.customer_name || ''}}
          <text wx:if="{{item.mobile}}"> · {{item.mobile}}</text>
        </view>
      </view>
      <view class="package-code">{{item.pickup_code}}</view>
    </view>
  </view>

</view>
