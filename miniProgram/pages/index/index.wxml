<!-- 首页：查件 -->
<view class="page">

  <!-- 搜索 -->
  <view class="search-wrap">
    <view class="input-wrap {{searchFocus ? 'input-wrap-focus' : ''}}">
      <view class="input-prefix">🔍</view>
      <input
        class="input"
        placeholder="输入单号后5位 / 全部单号 / 号码"
        value="{{keyword}}"
        bindinput="onInput"
        bindfocus="searchFocus = true"
        bindblur="searchFocus = false"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <view class="input-clear" wx:if="{{keyword}}" bindtap="onClear">✕</view>
    </view>
    <view class="btn btn-brand search-btn" bindtap="onSearch">查询</view>
  </view>

  <!-- 快捷操作 -->
  <view class="shortcuts">
    <view class="shortcut" bindtap="onRefresh">
      <text class="shortcut-icon">🔄</text>
      <text>刷新</text>
    </view>
    <view class="shortcut" bindtap="onGoBindPhone">
      <text class="shortcut-icon">📋</text>
      <text>号码管理</text>
    </view>
  </view>

  <!-- 公告 -->
  <view class="notice" wx:if="{{notices.length}}">
    <view class="notice-icon">📢</view>
    <view class="notice-text">{{notices[noticeIdx]}}</view>
  </view>

  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="card skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton" style="width:55%;height:28rpx;margin-bottom:16rpx;"></view>
      <view class="skeleton" style="width:35%;height:22rpx;"></view>
    </view>
  </block>

  <!-- 空状态：加载异常 -->
  <view wx:elif="{{error && packages.length === 0}}" class="empty">
    <view class="empty-illustration">
      <view class="empty-circle">
        <text class="empty-emoji">⚠️</text>
      </view>
    </view>
    <view class="empty-title">加载失败</view>
    <view class="empty-desc">包裹信息获取失败，请稍后重试</view>
    <view class="btn btn-brand btn-lg" bindtap="onRefresh">重新加载</view>
  </view>

  <!-- 空状态：未绑定 -->
  <view wx:elif="{{!hasPhones && packages.length === 0}}" class="empty">
    <view class="empty-illustration">
      <view class="empty-circle">
        <text class="empty-emoji">📋</text>
      </view>
    </view>
    <view class="empty-title">还没有绑定号码</view>
    <view class="empty-desc">绑定后自动为你查件，包裹到站不再错过</view>
    <view class="btn btn-brand btn-lg" bindtap="onGoBindPhone">
      <text class="btn-icon">＋</text> 添加号码
    </view>
  </view>

  <!-- 空状态：无包裹 -->
  <view wx:elif="{{packages.length === 0}}" class="empty">
    <view class="empty-illustration">
      <view class="empty-circle empty-circle-ok">
        <text class="empty-emoji">✅</text>
      </view>
    </view>
    <view class="empty-title">全部取完了</view>
    <view class="empty-desc">当前没有快递，可添加更多号码</view>
    <view class="btn btn-brand btn-lg" bindtap="onGoBindPhone">号码管理</view>
  </view>

  <!-- 包裹列表 -->
  <view wx:else class="package-list">
    <view class="list-header">
      <text class="list-title">待取包裹</text>
      <text class="list-count">{{packages.length}} 件</text>
    </view>
    <view class="card package-card" wx:for="{{packages}}" wx:key="waybill_code">
      <view class="package-main">
        <view class="package-left">
          <view class="package-waybill">{{item.waybill_code}}</view>
          <view class="package-info text-secondary">
            {{item.customer_name || ''}}
            <text wx:if="{{item.mobile}}"> · {{item.mobile}}</text>
          </view>
        </view>
        <view class="package-right" wx:if="{{item.pickup_code}}">
          <view class="package-code">{{item.pickup_code}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- Toast -->
  <view class="toast {{showToast ? 'toast-show' : ''}}" wx:if="{{toastText}}">
    <text>{{toastText}}</text>
  </view>

</view>
