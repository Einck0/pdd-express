<!-- 首页：查件 -->
<view class="page">

  <!-- 公告 -->
  <view class="notice" wx:if="{{notices.length}}">
    <view class="notice-icon">📢</view>
    <view class="notice-text">{{notices[noticeIdx]}}</view>
  </view>

  <!-- 搜索 -->
  <view class="search-wrap">
    <view class="input-wrap {{searchFocus ? 'input-wrap-focus' : ''}}">
      <input
        class="input"
        placeholder="输入运单号或手机号查询"
        value="{{keyword}}"
        bindinput="onInput"
        bindfocus="searchFocus = true"
        bindblur="searchFocus = false"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <view class="input-clear" wx:if="{{keyword}}" bindtap="onClear">✕</view>
    </view>
    <view class="btn btn-brand btn-sm search-btn" bindtap="onSearch">查件</view>
  </view>

  <!-- 快捷操作 -->
  <view class="shortcuts">
    <view class="shortcut" bindtap="onRefresh">
      <text class="shortcut-icon">🔄</text>
      <text>刷新</text>
    </view>
    <view class="shortcut" bindtap="onGoBindPhone">
      <text class="shortcut-icon">📱</text>
      <text>手机号</text>
    </view>
  </view>

  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="card skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton" style="width:55%;height:28rpx;margin-bottom:16rpx;"></view>
      <view class="skeleton" style="width:35%;height:22rpx;"></view>
    </view>
  </block>

  <!-- 空状态：未绑定 -->
  <view wx:elif="{{!hasPhones}}" class="empty">
    <view class="empty-icon">📱</view>
    <view class="empty-title">还没有绑定手机号</view>
    <view class="empty-desc">绑定手机号后自动为你查件</view>
    <view class="btn btn-brand btn-sm" style="width:240rpx;" bindtap="onGoBindPhone">去绑定</view>
  </view>

  <!-- 空状态：无包裹 -->
  <view wx:elif="{{packages.length === 0}}" class="empty">
    <view class="empty-icon">📦</view>
    <view class="empty-title">暂无待取包裹</view>
    <view class="empty-desc">有包裹时会自动出现在这里</view>
  </view>

  <!-- 包裹列表 -->
  <view wx:else class="package-list">
    <view class="card package-card" wx:for="{{packages}}" wx:key="waybill_code"
      data-code="{{item.pickup_code}}" data-waybill="{{item.waybill_code}}"
      bindtap="onCopyCode" bindlongpress="onCopyWaybill">
      <view class="package-top">
        <view class="package-waybill">{{item.waybill_code}}</view>
        <view class="package-badge" wx:if="{{item.pickup_code}}">待取</view>
      </view>
      <view class="package-bottom">
        <view class="package-info text-secondary">
          {{item.customer_name || ''}}
          <text wx:if="{{item.mobile}}"> · {{item.mobile}}</text>
        </view>
        <view class="package-code" wx:if="{{item.pickup_code}}">{{item.pickup_code}}</view>
      </view>
      <view class="package-hint text-muted">点击取件码可复制 · 长按复制单号</view>
    </view>
  </view>

  <!-- Toast -->
  <view class="toast {{showToast ? 'toast-show' : ''}}" wx:if="{{toastText}}">
    <text>{{toastText}}</text>
  </view>

</view>
