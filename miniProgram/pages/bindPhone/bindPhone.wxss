/* 号码管理页样式 — v2 */

.page {
  padding: var(--space-lg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── 顶部 ── */
.header {
  margin-bottom: var(--space-xl);
  padding-bottom: var(--space-lg);
  border-bottom: 2rpx solid var(--color-separator);
}

.header-icon {
  font-size: 64rpx;
  margin-bottom: var(--space-sm);
}

.header-title {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}

/* ── 添加区域 ── */
.add-section {
  margin-bottom: var(--space-xl);
}

.add-form {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-xs);
}

.add-form .input-prefix {
  font-size: 28rpx;
  margin-right: var(--space-xs);
}

.add-btn {
  flex-shrink: 0;
  width: 140rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  font-size: var(--text-base);
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, .3);
}

.add-hint {
  font-size: var(--text-xs);
  padding-left: var(--space-xs);
}

/* ── 列表头 ── */
.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-sm);
  padding: 0 var(--space-xs);
}

.list-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.list-count {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  background: var(--color-bg-hover);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
}

/* ── 号码列表 ── */
.phone-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-lg);
  background: var(--color-card);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-sm);
  box-shadow: var(--shadow-sm);
  transition: transform .15s;
}

.phone-item:active {
  transform: scale(.985);
}

.phone-main {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.phone-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(7, 193, 96, .1) 0%, rgba(7, 193, 96, .04) 100%);
  border: 2rpx solid rgba(7, 193, 96, .15);
  color: var(--color-brand-dark);
  font-size: var(--text-lg);
  font-weight: 700;
  flex-shrink: 0;
}

.phone-detail {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.phone-number {
  font-size: var(--text-lg);
  font-weight: 600;
  font-family: "DIN Alternate", "Helvetica Neue", monospace;
  letter-spacing: 2rpx;
  color: var(--color-text);
}

.phone-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--text-xs);
  color: var(--color-brand);
  font-weight: 500;
}

.tag-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-brand);
}

.phone-remove {
  padding: 12rpx var(--space-md);
  font-size: var(--text-sm);
  color: var(--color-danger);
  background: rgba(250, 81, 81, .06);
  border-radius: var(--radius-sm);
  font-weight: 500;
  transition: background .15s;
}

.phone-remove:active {
  background: rgba(250, 81, 81, .12);
}

/* ── 空状态 ── */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx var(--space-xl) 80rpx;
}

.empty-illustration {
  margin-bottom: var(--space-xl);
}

.empty-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(7, 193, 96, .08) 0%, rgba(7, 193, 96, .02) 100%);
  border: 4rpx solid rgba(7, 193, 96, .12);
}

.empty-emoji {
  font-size: 72rpx;
}

.empty-title {
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-xs);
}

.empty-desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  text-align: center;
  line-height: 1.8;
}
