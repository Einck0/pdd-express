/* pages/bindPhone/bindPhone.wxss */
.page-bind {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---- 添加卡片 ---- */
.add-card {
  margin-bottom: 32rpx;
}

.add-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.phone-input {
  background: var(--bg);
  border-radius: 40rpx;
  padding: 20rpx 32rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
  height: 80rpx;
  box-sizing: border-box;
}

/* ---- 协议 ---- */
.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.agree-text {
  line-height: 1.6;
}

/* ---- 列表 ---- */
.list-section {
  margin-top: 16rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--text-secondary);
}

.phone-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card-bg);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}

.phone-num {
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.skeleton-phone {
  height: 88rpx;
  margin-bottom: 16rpx;
  border-radius: var(--radius);
}
