/* 手机号管理页样式 */
.page { padding: 24rpx; }

.agree-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.agree-text { color: var(--text-muted); }

.link {
  color: var(--primary);
  font-size: 24rpx;
}

.agreement-card {
  font-size: 22rpx;
  color: var(--text-sub);
  line-height: 1.8;
}

/* 手机号卡片 */
.phone-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  margin-bottom: 16rpx;
}

.phone-number {
  font-size: 32rpx;
  font-weight: 600;
  font-family: "DIN", "Helvetica Neue", monospace;
  letter-spacing: 2rpx;
}

.phone-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  background: rgba(250, 81, 81, 0.1);
  color: var(--danger);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 500;
}

.phone-delete:active { opacity: 0.8; }
