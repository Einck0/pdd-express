/**
 * 手机号管理页样式
 */

.page-container {
  padding: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 32rpx);
}

/* ========== 输入区 ========== */
.input-section {
  padding: 32rpx;
}

.input-label {
  font-weight: 500;
}

/* ========== 协议勾选 ========== */
.agree-row {
  align-items: center;
}

.checkbox-wrap {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 6rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 12rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #FFFFFF;
  transition: all 0.2s;
}

.checkbox-wrap.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.agree-text {
  line-height: 1.5;
}

.link-text {
  color: var(--color-primary);
}

/* ========== 添加按钮 ========== */
.input-section .btn {
  width: 100%;
}

/* ========== 协议展开 ========== */
.agreement-card {
  margin-top: 16rpx;
}

.agreement-header {
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--color-border);
  margin-bottom: 16rpx;
}

.close-btn {
  font-size: 32rpx;
  color: var(--color-text-secondary);
  padding: 8rpx;
}

.agreement-content {
  max-height: 600rpx;
  overflow-y: auto;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.agreement-content view {
  margin-bottom: 16rpx;
}

.yhxy {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 16rpx;
}

.myOne {
  padding: 8rpx;
}

.my-div view {
  margin-bottom: 12rpx;
}

/* ========== 列表标题 ========== */
.section-title {
  padding: 0 8rpx;
}

/* ========== 手机号卡片 ========== */
.phone-list {
  margin-top: 8rpx;
}

.phone-card {
  padding: 24rpx 32rpx;
}

.phone-number {
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.delete-btn {
  flex-shrink: 0;
  width: 120rpx;
}

/* ========== 骨架屏 ========== */
.skeleton-list {
  margin-top: 8rpx;
}
