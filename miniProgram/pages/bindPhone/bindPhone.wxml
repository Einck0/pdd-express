<!-- 手机号管理页 -->
<view class="page">

  <!-- 输入区 -->
  <view class="card">
    <view class="input-wrap {{inputFocus ? 'input-wrap-focus' : ''}}">
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="输入凭证"
        value="{{phone}}"
        bindinput="onPhoneInput"
        bindfocus="onInputFocus"
        bindblur="onInputBlur"
      />
      <view class="input-clear" wx:if="{{phone}}" bindtap="onPhoneClear">✕</view>
    </view>

    <button
      class="btn btn-brand {{adding ? 'btn-loading' : ''}}"
      disabled="{{adding}}"
      bindtap="onAdd"
    >{{adding ? '添加中…' : '添加'}}</button>
  </view>

  <!-- 手机号列表 -->
  <view class="section-title text-secondary" wx:if="{{!loading && phones.length > 0}}">已绑定号码</view>

  <block wx:if="{{loading}}">
    <view class="card" wx:for="{{[1,2]}}" wx:key="*this" style="padding:32rpx;">
      <view class="skeleton" style="width:50%;height:32rpx;"></view>
    </view>
  </block>

  <view wx:elif="{{phones.length === 0}}" class="empty">
    <view class="empty-icon">📱</view>
    <view class="empty-title">还没有绑定号码</view>
    <view class="empty-desc">添加后自动为你查件</view>
  </view>

  <block wx:else>
    <view class="card phone-card" wx:for="{{phones}}" wx:key="*this">
      <view class="phone-left">
        <view class="phone-icon">📱</view>
        <view class="phone-number">{{item}}</view>
      </view>
      <view class="phone-delete" data-phone="{{item}}" bindtap="onDelete">删除</view>
    </view>
  </block>

</view>
